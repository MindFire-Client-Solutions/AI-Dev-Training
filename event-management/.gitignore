# ---------------------------------------------------------------------------
# Client data — never commit. Contact lists and generated event batches both
# contain PURLs and contact IDs tied to real campaigns.
# ---------------------------------------------------------------------------
input/*
!input/.gitkeep

output/*
!output/.gitkeep

# Cloudflare Pages build output (npm run build)
dist/

# The real export contains client contact data (names, emails, PURLs).
# Never commit it.
reference/*.csv

